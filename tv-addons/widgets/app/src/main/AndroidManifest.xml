<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Only for the F1 calendar and standings (Jolpica-F1, or the fork's GitHub mirror) and the weather
         (Open-Meteo) for the one city chosen on the phone. Nothing else goes online; no telemetry. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Screen">

        <activity
            android:name=".HubActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Clean Your TV module card (docs/specs/card.md): ASCII only, literal values. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Clean Your TV launcher, game_day (docs/modules.md): the lines under the clock. -->
        <meta-data android:name="com.gathin.tvhome.games" android:value="tv.cleanyour.ru.widgets.games" />

        <!-- Read-only and holding nothing private: only what Home shows anyway. -->
        <provider
            android:name=".GamesProvider"
            android:authorities="tv.cleanyour.ru.widgets.games"
            android:exported="true" />

        <!-- The phone app's door, over ADB: WRITE_SECURE_SETTINGS is held by the ADB shell only, so no app on the
             TV can read or change the settings (the city) through it. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="tv.cleanyour.ru.widgets.config"
            android:exported="true"
            android:readPermission="android.permission.WRITE_SECURE_SETTINGS"
            android:writePermission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
