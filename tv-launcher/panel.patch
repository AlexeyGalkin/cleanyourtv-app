diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WidgetPanel.java b/launcher/app/src/main/java/com/gathin/tvhome/WidgetPanel.java
new file mode 100644
index 00000000..68f4d04d
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WidgetPanel.java
@@ -0,0 +1,192 @@
+package com.gathin.tvhome;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ProviderInfo;
+import android.database.ContentObserver;
+import android.database.Cursor;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+import android.os.Handler;
+
+import java.io.InputStream;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+
+/**
+ * widget_panel (Clean Your TV RU): pictures an add-on draws for two places of Home, under the clock on the left and
+ * the empty middle on the right (two equal 412×176 dp cards), shown as they are. The launcher only reads what the add-on publishes and stays
+ * offline; the add-on draws the weather, F1 and the like into images at this screen's density.
+ * <p>
+ * Contract: the add-on names a read-only provider in {@code <meta-data android:name="com.gathin.tvhome.panel"
+ * android:value="<authority>">} on its application; {@code content://<authority>/panel} answers rows of
+ * {@code slot} ("left" or "right"), {@code uri} (a PNG of that provider) and {@code revision} (changes when the
+ * picture does). An empty cursor hides both. The owner turns it on by naming the package in widget_panel.
+ */
+final class WidgetPanel {
+    static final String META = "com.gathin.tvhome.panel";
+    private static final String[] COLUMNS = {"slot", "uri", "revision"};
+    /** A picture bigger than this is not shown (a 1080p screen's place is far smaller). */
+    private static final int MAX_BYTES = 2 * 1024 * 1024;
+    private static final long MAX_PIXELS = 3_000_000L;
+    // The last pictures, process-wide: a recreated Home shows them at once instead of the race panel first.
+    private static String lastAuthority;
+    private static Bitmap lastLeft, lastRight;
+    private static long lastLeftRev = -1, lastRightRev = -1;
+
+    private final Context ctx;
+    private final String authority;
+    private final Uri uri;
+    private final Handler main;
+    private final Runnable onChange;
+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private final ContentObserver observer;
+    private boolean watching;
+    private Bitmap left, right;
+    private long leftRev = -1, rightRev = -1;
+    // The io thread's own copy, so back-to-back reads do not decode the same picture twice.
+    private Bitmap ioLeft, ioRight;
+    private long ioLeftRev = -1, ioRightRev = -1;
+
+    private WidgetPanel(Context ctx, String authority, Handler main, Runnable onChange) {
+        this.ctx = ctx;
+        this.authority = authority;
+        this.uri = new Uri.Builder().scheme(ContentResolver.SCHEME_CONTENT).authority(authority).appendPath("panel").build();
+        this.main = main;
+        this.onChange = onChange;
+        if (authority.equals(lastAuthority)) {
+            left = lastLeft;
+            right = lastRight;
+            leftRev = lastLeftRev;
+            rightRev = lastRightRev;
+            ioLeft = left;
+            ioRight = right;
+            ioLeftRev = leftRev;
+            ioRightRev = rightRev;
+        }
+        observer = new ContentObserver(main) {
+            @Override
+            public void onChange(boolean selfChange) {
+                read();
+            }
+        };
+    }
+
+    /** Null when the key is empty, the package is not installed, or it names no provider of its own. */
+    static WidgetPanel create(Context ctx, String pkg, Handler main, Runnable onChange) {
+        if (pkg == null || pkg.trim().isEmpty()) return null;
+        try {
+            PackageManager pm = ctx.getPackageManager();
+            ApplicationInfo info = pm.getApplicationInfo(pkg.trim(), PackageManager.GET_META_DATA);
+            String authority = info.metaData == null ? null : info.metaData.getString(META);
+            if (authority == null || authority.trim().isEmpty()) return null;
+            ProviderInfo provider = pm.resolveContentProvider(authority.trim(), 0);
+            if (provider == null || !pkg.trim().equals(provider.packageName)) return null;
+            return new WidgetPanel(ctx, authority.trim(), main, onChange);
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+
+    /** Home is on screen: read now and watch for changes. */
+    void start() {
+        if (!watching) {
+            try {
+                ctx.getContentResolver().registerContentObserver(uri, false, observer);
+                watching = true;
+            } catch (SecurityException e) {
+                // The provider went away; the panel keeps what it had.
+            }
+        }
+        read();
+    }
+
+    void stop() {
+        if (watching) ctx.getContentResolver().unregisterContentObserver(observer);
+        watching = false;
+    }
+
+    void shutdown() {
+        stop();
+        io.shutdownNow();
+    }
+
+    /** One query and the changed pictures off the main thread, then onChange on the main thread. */
+    void read() {
+        try {
+            io.execute(() -> {
+                String leftUri = null, rightUri = null;
+                long lr = -1, rr = -1;
+                try (Cursor c = ctx.getContentResolver().query(uri, COLUMNS, null, null, null)) {
+                    while (c != null && c.moveToNext()) {
+                        String slot = c.getString(0);
+                        if ("left".equals(slot)) { leftUri = c.getString(1); lr = c.getLong(2); }
+                        if ("right".equals(slot)) { rightUri = c.getString(1); rr = c.getLong(2); }
+                    }
+                } catch (RuntimeException gone) {
+                    return;   // uninstalled or crashed mid-query: keep what is on screen
+                }
+                if (leftUri == null) { ioLeft = null; ioLeftRev = -1; }
+                else if (lr != ioLeftRev || ioLeft == null) { Bitmap b = load(leftUri); if (b != null || ioLeft == null) { ioLeft = b; ioLeftRev = b == null ? -1 : lr; } }
+                if (rightUri == null) { ioRight = null; ioRightRev = -1; }
+                else if (rr != ioRightRev || ioRight == null) { Bitmap b = load(rightUri); if (b != null || ioRight == null) { ioRight = b; ioRightRev = b == null ? -1 : rr; } }
+                final Bitmap l = ioLeft, r = ioRight;
+                final long flr = ioLeftRev, frr = ioRightRev;
+                main.post(() -> {
+                    boolean same = l == left && r == right;
+                    left = l;
+                    right = r;
+                    leftRev = flr;
+                    rightRev = frr;
+                    lastAuthority = authority;
+                    lastLeft = l;
+                    lastRight = r;
+                    lastLeftRev = flr;
+                    lastRightRev = frr;
+                    if (!same) onChange.run();
+                });
+            });
+        } catch (RejectedExecutionException shutDown) {
+            // Home is being destroyed.
+        }
+    }
+
+    /**
+     * A picture of the add-on's own provider only: at most 2 MB of PNG and 3 million pixels (a card at 4x density is
+     * about 1.2 million), or nothing. A failure of any kind, out of memory too, keeps Home running.
+     */
+    private Bitmap load(String s) {
+        Uri u = Uri.parse(s);
+        if (!ContentResolver.SCHEME_CONTENT.equals(u.getScheme()) || !authority.equals(u.getAuthority())) return null;
+        try (InputStream in = ctx.getContentResolver().openInputStream(u)) {
+            if (in == null) return null;
+            java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream(256 * 1024);
+            byte[] buf = new byte[16 * 1024];
+            int r;
+            while ((r = in.read(buf)) > 0) {
+                out.write(buf, 0, r);
+                if (out.size() > MAX_BYTES) return null;
+            }
+            byte[] bytes = out.toByteArray();
+            BitmapFactory.Options bounds = new BitmapFactory.Options();
+            bounds.inJustDecodeBounds = true;
+            BitmapFactory.decodeByteArray(bytes, 0, bytes.length, bounds);
+            if (bounds.outWidth <= 0 || bounds.outHeight <= 0 || (long) bounds.outWidth * bounds.outHeight > MAX_PIXELS) return null;
+            return BitmapFactory.decodeByteArray(bytes, 0, bytes.length);
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    Bitmap left() {
+        return left;
+    }
+
+    Bitmap right() {
+        return right;
+    }
+}
