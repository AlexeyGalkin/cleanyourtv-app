+    // ---- widget_panel (Clean Your TV RU) ------------------------------------------------------------
+
+    /** While the add-on's cards show, they take the race panel's place (its game_day lines would repeat them). */
+    private boolean panelOwnsLeft() {
+        return widgetPanel != null && panelFits && (widgetPanel.left() != null || widgetPanel.right() != null);
+    }
+
+    /**
+     * Places the two cards between the clock (and the stats line) and the dock as they are laid out: 12 dp under the
+     * clock, as tall as fits up to 176 dp, 412:176 wide, mirrored at the screen's edges. Above the shelf (the focused
+     * app's name) when there is room for 150 dp, else down to the dock with the shelf hidden; under 120 dp, not at all.
+     */
+    private void layoutWidgetPanel() {
+        if (widgetPanel == null || panelLeft == null) return;
+        View root = findViewById(R.id.root);
+        int[] at = new int[2];
+        root.getLocationInWindow(at);
+        int rootY = at[1];
+        clockBlock.getLocationInWindow(at);
+        int headerBottom = at[1] - rootY + clockBlock.getHeight();
+        if (stats != null && stats.getVisibility() == View.VISIBLE) {
+            stats.getLocationInWindow(at);
+            headerBottom = Math.max(headerBottom, at[1] - rootY + stats.getHeight());
+        }
+        grid.getLocationInWindow(at);
+        int dockTop = at[1] - rootY + grid.getPaddingTop();
+        int gap = (int) (12 * density);
+        int top = headerBottom + gap;
+        int heroTop = dockTop - (int) (40 * density) - (dockTitleOn ? hero.getHeight() : 0);
+        int full = (int) (176 * density);
+        int h;
+        boolean coversHero;
+        if (!dockTitleOn || heroTop - gap - top >= (int) (150 * density)) {
+            h = Math.min(full, (dockTitleOn ? heroTop : dockTop) - gap - top);
+            coversHero = false;
+        } else {
+            h = Math.min(full, dockTop - gap - top);
+            coversHero = true;
+        }
+        boolean fits = h >= (int) (120 * density);
+        int w = Math.round(h * 412f / 176f);
+        for (android.widget.ImageView card : new android.widget.ImageView[] {panelLeft, panelRight}) {
+            android.widget.FrameLayout.LayoutParams lp = (android.widget.FrameLayout.LayoutParams) card.getLayoutParams();
+            if (lp.topMargin != top || lp.height != h || lp.width != w) {
+                lp.topMargin = top;
+                lp.height = h;
+                lp.width = w;
+                card.setLayoutParams(lp);
+            }
+        }
+        if (fits != panelFits || coversHero != panelCoversHero) {
+            panelFits = fits;
+            panelCoversHero = coversHero;
+            handler.post(this::showWidgetPanel);
+        }
+    }
+
+    /** New pictures from the add-on: show them; while any shows, the focused app's name above the dock stays hidden. */
+    private void showWidgetPanel() {
+        if (widgetPanel == null) return;
+        android.graphics.Bitmap l = panelFits ? widgetPanel.left() : null, r = panelFits ? widgetPanel.right() : null;
+        panelLeft.setImageBitmap(l);
+        panelLeft.setVisibility(l == null ? View.GONE : View.VISIBLE);
+        panelRight.setImageBitmap(r);
+        panelRight.setVisibility(r == null ? View.GONE : View.VISIBLE);
+        if (l != null || r != null) racePanel.setVisibility(View.GONE);
+        else updatePanel();
+        // The shelf (the focused app's name) goes only when a card covers its place; INVISIBLE keeps its height for setY.
+        if (dockTitleOn) hero.setVisibility((l != null || r != null) && panelCoversHero ? View.INVISIBLE : View.VISIBLE);
+    }
